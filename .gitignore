cache/

# --- Node / frontend (regenerable) -----------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# --- OS cruft --------------------------------------------------------------
Thumbs.db
.DS_Store

# NOTE: data/ (synthetic patient notes) and outputs/ (deliverable drafts +
# traces) are intentionally tracked so the project is runnable and reviewable.
