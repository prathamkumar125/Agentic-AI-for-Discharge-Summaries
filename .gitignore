# --- Secrets: NEVER commit -------------------------------------------------
.env
*.env
!.env.example

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# --- Generated caches (large, regenerable) ---------------------------------
